{
  "listen_addr": "127.0.0.1:8787",
  "protocol": "openai",
  "base_url": "https://api.openai.com/v1",
  "model": "replace-with-your-model-id",
  "upstream_id": "openai-primary",
  "upstream_keychain": {
    "service": "com.tidemux.openai",
    "account": "default"
  },
  "access_token_keychain": {
    "service": "com.tidemux.gateway",
    "account": "default"
  },
  "max_in_flight": 1,
  "prices": {
    "replace-with-your-model-id": {
      "currency": "USD",
      "source": "replace-with-verified-source",
      "version": "replace-with-source-version",
      "input_cache_hit_per_million": 1,
      "input_cache_miss_per_million": 1,
      "output_per_million": 1
    }
  },
  "ledger_path": "/Users/you/Library/Application Support/TideMux/ledger.db",
  "budget": {
    "currency": "USD",
    "five_hour_limit": 5,
    "weekly_limit": 80,
    "alert_threshold": 0.8,
    "mode": "hard"
  }
}
