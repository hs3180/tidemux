{
  "listen_addr": "127.0.0.1:4000",
  "providers": {
    "deepseek-openai": {
      "base_url": "https://api.deepseek.com/v1",
      "model": "openai-model-id",
      "upstream_id": "deepseek-openai",
      "upstream_keychain": {
        "service": "com.tidemux.provider",
        "account": "deepseek-openai-key"
      }
    },
    "deepseek-anthropic": {
      "base_url": "https://api.deepseek.com/anthropic/v1",
      "anthropic_version": "2023-06-01",
      "model": "anthropic-model-id",
      "upstream_id": "deepseek-anthropic",
      "upstream_keychain": {
        "service": "com.tidemux.provider",
        "account": "deepseek-anthropic-key"
      }
    }
  },
  "default_providers": {
    "openai": "deepseek-openai",
    "anthropic": "deepseek-anthropic"
  },
  "access_token_keychain": {
    "service": "com.tidemux.gateway",
    "account": "default"
  },
  "max_in_flight": 1,
  "ledger_path": "/Users/you/Library/Application Support/TideMux/ledger.db"
}
