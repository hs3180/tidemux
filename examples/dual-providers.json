{
  "listen_addr": "127.0.0.1:4000",
  "base_url": "https://provider.example/v1",
  "providers": {
    "openai": {
      "model": "openai-model-id",
      "upstream_id": "openai-provider",
      "upstream_keychain": {
        "service": "com.tidemux.provider",
        "account": "openai-key"
      }
    },
    "anthropic": {
      "anthropic_version": "2023-06-01",
      "model": "anthropic-model-id",
      "upstream_id": "anthropic-provider",
      "upstream_keychain": {
        "service": "com.tidemux.provider",
        "account": "anthropic-key"
      }
    }
  },
  "access_token_keychain": {
    "service": "com.tidemux.gateway",
    "account": "default"
  },
  "max_in_flight": 1,
  "ledger_path": "/Users/you/Library/Application Support/TideMux/ledger.db"
}
