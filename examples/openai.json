{
  "listen_addr": "127.0.0.1:4000",
  "protocol": "openai",
  "base_url": "https://api.openai.com/v1",
  "model": "replace-with-your-model-id",
  "upstream_id": "openai-primary",
  "upstream_keychain": {
    "service": "com.tidemux.openai",
    "account": "default"
  },
  "access_token_keychain": {
    "service": "com.tidemux.gateway",
    "account": "default"
  },
  "max_in_flight": 1,
  "max_active_sessions": 0,
  "active_session_idle_timeout_seconds": 0,
  "ledger_path": "/Users/you/Library/Application Support/TideMux/ledger.db"
}
